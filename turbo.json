{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": ["eslint.cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "devPackages": {
      "dependsOn": [
        "@repo/ui#build", 
        "@repo/pokedex#build", 
        "@repo/pokeapi#build", 
        "@repo/adventure#build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
